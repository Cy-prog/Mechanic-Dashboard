datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String
  address   String
  city      String    @default("Metro Area")
  avatarUrl String?
  vehicles  Vehicle[]
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Vehicle {
  id           String    @id @default(uuid())
  make         String
  model        String
  year         Int
  licensePlate String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

model Mechanic {
  id              String    @id @default(uuid())
  name            String
  phone           String
  email           String    @unique
  avatarUrl       String?
  status          String    @default("AVAILABLE") // AVAILABLE, BUSY, EN_ROUTE, OFFLINE
  rating          Float     @default(4.8)
  specialization  String    @default("General Automotive")
  jobsCompleted   Int       @default(0)
  latitude        Float     @default(37.7749)
  longitude       Float     @default(-122.4194)
  currentBookingId String?
  bookings        Booking[]
  createdAt       DateTime  @default(now())
}

model Booking {
  id                String          @id
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id])
  mechanicId        String?
  mechanic          Mechanic?       @relation(fields: [mechanicId], references: [id])
  serviceCategory   String
  serviceName       String
  status            String          @default("PENDING") // PENDING, ASSIGNED, EN_ROUTE, IN_PROGRESS, COMPLETED, CANCELLED
  priority          String          @default("MEDIUM")  // LOW, MEDIUM, HIGH, EMERGENCY
  amount            Float
  estimatedDuration Int             @default(60) // in minutes
  notes             String?
  customerAddress   String
  customerLat       Float           @default(37.7749)
  customerLng       Float           @default(-122.4194)
  scheduledAt       DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  statusTimeline    StatusHistory[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model StatusHistory {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  timestamp DateTime @default(now())
  note      String?
}
